---
export async function getStaticPaths() {
  const res = await fetch("https://wger.de/api/v2/exerciseinfo/");
  const data = await res.json();

  return data.results.map((exercise) => ({
    params: { id: exercise.id.toString() },
    props: {
      exercise: {
        ...exercise,
        image: exercise.images?.[0]?.image
          ? `https://wger.de${exercise.images[0].image}`
          : null,
      },
    },
  }));
}

const { exercise } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{exercise.translations?.[0]?.name ?? "Exercise details"}</title>
        
        <link rel="stylesheet" href="/styles/main.css">
    </head>
    <body>
        <header>
            <a href="/">Home</a>
            <div>
                <a href="/workouts">Create Workout</a>
                <a href="/exercises">Exercises</a>
            </div>
        </header>

        <div class="details">
            <a href="/exercises"><- Back</a>
            <div>
                {exercise.image && (
                    <img src={exercise.image} alt={exercise.translations?.[0]?.name ?? "Exercise"} />
                )}
                <div>
                    <h1>{exercise.translations?.[0]?.name ?? "Unnamed"}</h1>   
                    <p>{exercise.category?.name ?? "Unknown category"}</p>
                    
                </div>
            </div>

            <div>
                <div>
                    <p>Category</p>
                    <p>{exercise.category?.name ?? "Unknown category"}</p>
                </div>
                <div>
                    <p>Primary muscle</p>
                    <p>{exercise.muscles?.[0]?.name ?? "Unknown"}</p>
                </div>
                <div>
                    <p>Equipment</p>    
                    <p>{exercise.equipment?.[0]?.name ?? "No equipment"}</p>
                </div>
            </div>

            <div>
                <h2>Description</h2>
                <p>{exercise.translations?.[0]?.description_source ?? ""}</p>
            </div>
        </div>
    </body>
</html>

