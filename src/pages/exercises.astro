---
const fetchExercises = await fetch("https://wger.de/api/v2/exerciseinfo/"); 

const responseExercises = await fetchExercises.json();

//Structure exercises data
const exercises = responseExercises.results.map((exercise) => ({
	id: exercise.id,
	name: exercise.translations?.[0]?.name ?? "Unnamed",
	category: exercise.category?.name ?? "Unknown",
	muscles: exercise.muscles?.map(m => m.name ?? m) ?? [],
	equipment: exercise.equipment?.map(e => e.name ?? e) ?? [],
	// image: exercise.images?.[0]?.image ?? null,
	image: exercise.images?.[0]?.image
		? `https://wger.de${exercise.images[0].image}`
		: null,
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>

		<link rel="stylesheet" href="/styles/main.css">
	</head>
	<body>
        <header>
            <a href="/">Home</a>
            <div>
                <a href="/workouts">Create Workout</a>
                <a href="/exercises">Exercises</a>
            </div>
        </header>
        <div class="intro">
            <h1>Exercises</h1>
            <p>Browse all available exercises by muscle group.</p>
        </div>
        <div class="exercises">
            <ul>
                {exercises.map((exercise) => {
                    return (  
                        <a href={`/${exercise.id}`}>
                            {exercise.image && (
                                <img src={exercise.image} alt={exercise.name}>
                            )}
                            <div>
                                <p>{exercise.name}</p>
                                <p>{exercise.category}</p>
                            </div>
                        </a>
                    )
                })}
            </ul>
        </div>
	</body>
</html>
