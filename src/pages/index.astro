---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>FitTrack</title>

		<link rel="stylesheet" href="/styles/main.css">
		<link rel="stylesheet" href="/styles/index.css">
	</head>
	<body>
		<header>
            <a href="/">Home</a>
            <div>
                <a href="/workouts">Create Workout</a>
                <a href="/exercises">Exercises</a>
            </div>
        </header>
		
		<section>
			<div>
				<h1>Your fitness journey</h1>
				<p>Track your workouts, stay consistent, and build routines that actually work for you. Create custom workouts that fit your goals and watch your progress grow with every rep and every session.</p>
				<button>+ Create workout</button>
			</div>
		</section>

		<section>	
			<div>
				<p>Workouts</p>
				<p id="workout_count">0</p>
			</div>
		</section>

		<section>
			<div>
				<h2>Your workouts</h2>
				<a href="/workouts">+ Create new</a>
			</div>
			<div id="workouts_container">

			</div>
		</section>
		<script>
			const workouts = JSON.parse(localStorage.getItem("workouts") ?? "[]");
			const container = document.getElementById("workouts_container");

			document.getElementById("workout_count").textContent = workouts.length;

			container.innerHTML = workouts.map(w => `
				<div>
				<h3>${w.name}</h3>
				<ul>
					${w.exercises.map(e => `<li>${e.name} — ${e.sets} sets · ${e.weight} kg</li>`).join("")}
				</ul>
				</div>
			`).join("") || "<p>No workouts saved yet.</p>";
		</script>
	</body>
</html>

