---
const fetchExercises = await fetch("https://wger.de/api/v2/exerciseinfo/"); 

const responseExercises = await fetchExercises.json();

//Structure exercises data
const exercises = responseExercises.results.map((exercise) => ({
	id: exercise.id,
	name: exercise.translations?.[0]?.name ?? "Unnamed",
	category: exercise.category?.name ?? "Unknown",
	muscles: exercise.muscles?.map(m => m.name ?? m) ?? [],
}));
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>API</title>

        <link rel="stylesheet" href="/styles/main.css">
    </head>
    <body>
        <header>
            <a href="/">Home</a>
            <div>
                <a href="/workouts">Create Workout</a>
                <a href="/exercises">Exercises</a>
            </div>
        </header>

        <div class="create">
            <h2>Create workout</h2>
            <p>Build your perfect workout by dragging exercises into your routine.</p>
        </div>

        <div class="workout">
            <div>
                <h2>Exercise Library</h2>
                <input type="text" id="search" placeholder="Search exercises..."/>
                <div> 
                    <ul class="field" id="list">
                        {exercises.sort((a, b) => a.id - b.id).map((exercise) => (
                            <li data-id={exercise.id} data-name={exercise.name.toLowerCase()}>
                                <p>{exercise.name}</p>
                                <div>
                                    <div class="counter">
                                        <p>sets</p>
                                        <button class="decrease">-</button>
                                        <input type="text" value="0" class="value"/>
                                        <button class="increase">+</button>
                                    </div>

                                    <div class="counter">
                                        <p>weight</p>
                                        <button class="decrease">-</button>
                                        <input type="text" value="0" class="value"/>
                                        <button class="increase">+</button>
                                    </div>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            <div>
                <h2>Workout exercises</h2>

                <ul class="field" id="workoutList"></ul>

                <div>
                    <button id="saveWorkout">Save Workout</button>
                </div>
            </div>
        </div>

        <script>
            import "../scripts/main.js";
        </script>
        <script>
            import "../scripts/store.js";
        </script>
    </body>
</html>